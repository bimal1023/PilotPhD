# Database
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/pilotphd

# OpenAI
OPENAI_API_KEY=sk-...

# JWT session secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Resend (email delivery)
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@yourdomain.com

# Brave Search (optional — used by email drafter and fellowship finder)
BRAVE_API_KEY=your-brave-api-key-here

# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000

# Set to "production" on the server — enables secure cookies and disables /docs
ENVIRONMENT=development

# gpt-5.6 (flagship alias) | gpt-5.6-terra (balanced) | gpt-5.6-luna (budget)
OPENAI_MODEL=gpt-5.6-terra
