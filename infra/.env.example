# Production env for the EC2 box. Copy to infra/.env on the server and fill in.
# Read by BOTH docker compose (POSTGRES_PASSWORD, DATA_DIR) and the backend
# container (everything else, via `env_file`).
#
# The frontend needs no runtime env — NEXT_PUBLIC_API_URL is baked in at build
# time from the build arg in docker-compose.prod.yml.

# --- Postgres (runs in a container on this box; no RDS) ---
POSTGRES_PASSWORD=generate-a-long-random-password
# Host path for the data EBS volume. Leave as-is unless you mounted it elsewhere.
DATA_DIR=/mnt/data

# --- Backend ---
# Host is the compose service name, not localhost. Password must match above.
DATABASE_URL=postgresql://postgres:generate-a-long-random-password@postgres:5432/pilotphd

OPENAI_API_KEY=sk-...

# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

RESEND_API_KEY=re_...
FROM_EMAIL=noreply@pilotphd.com

# Optional — email drafter and fellowship finder degrade without it.
BRAVE_API_KEY=

# Comma-separated allowed CORS origins.
FRONTEND_URL=https://pilotphd.com,https://www.pilotphd.com

# Enables Secure cookies and hides /docs. Must be exactly "production".
ENVIRONMENT=production

# gpt-5.6 (flagship alias) | gpt-5.6-terra (balanced) | gpt-5.6-luna (budget)
OPENAI_MODEL=gpt-5.6-terra
